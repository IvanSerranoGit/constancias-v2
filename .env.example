# ─────────────────────────────────────────────────────────────────────────────
# Configuración de Supabase (requeridas — sin estas la app no arranca)
# Dashboard de Supabase → Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# URL del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon). Se usa en cliente y servidor.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave service_role (SECRETA — solo servidor, nunca exponer al cliente).
# Omite RLS; la usan las API routes y la generación de folios.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key


# ─────────────────────────────────────────────────────────────────────────────
# Configuración institucional / de marca (opcionales — tienen defaults)
# Cambiar estas permite desplegar el mismo repo para otra organización.
# ─────────────────────────────────────────────────────────────────────────────

# Nombre de la organización / sistema. Aparece en el título del sitio (pestaña
# del navegador) y en el encabezado del panel de administración.
# Default: "Sistema de Constancias"
NEXT_PUBLIC_ORG_NAME=Sistema de Constancias

# Logo institucional. Puede ser una ruta dentro de /public (ej: /logo.png o
# /logo-v2.png) o una URL completa. Cada despliegue puede usar su propio logo.
# Default: /logo.png
NEXT_PUBLIC_LOGO_URL=/logo.png

# Colores de marca (formato hex #RRGGBB). Se inyectan en runtime y alimentan las
# utilidades de Tailwind bg-brand-red, text-brand-gold, etc.
# Default rojo primario:     #9e2349
NEXT_PUBLIC_BRAND_RED=#9e2349
# Default rojo oscuro (sidebar, hovers):  #691b32
NEXT_PUBLIC_BRAND_RED_DARK=#691b32
# Default dorado:            #cf9a46
NEXT_PUBLIC_BRAND_GOLD=#cf9a46
# Default dorado claro:      #f5d778
NEXT_PUBLIC_BRAND_GOLD_LIGHT=#f5d778

# Color del nombre del participante en el PDF de la constancia (formato hex).
# Solo servidor. Solo se usa como fallback cuando el curso no define nombre_color.
# Default: #1a1a2e
PDF_NAME_COLOR=#1a1a2e

# Prefijo de folio de respaldo. El prefijo normalmente se deriva del slug del
# curso (ej: "fesp" → "FESP"); este valor solo se usa si el slug no produce
# letras. Default: CERT
NEXT_PUBLIC_FOLIO_PREFIX_FALLBACK=CERT
